rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isNotRevoked() {
      return !('isRevoked' in request.auth.token && request.auth.token.isRevoked == true) &&
             (!('minAuthTime' in request.auth.token) || request.auth.token.auth_time >= request.auth.token.minAuthTime);
    }

    function isUnispectMaster() {
      return isAuthenticated() && isNotRevoked() &&
        ('isUnispectMaster' in request.auth.token && request.auth.token.isUnispectMaster == true);
    }

    function hasClientAccess(targetClientId) {
      return isAuthenticated() && isNotRevoked() && (
        isUnispectMaster() ||
        ('authorizedClients' in request.auth.token && targetClientId in request.auth.token.authorizedClients)
      );
    }

    function isClientAdmin(targetClientId) {
      return hasClientAccess(targetClientId) && (
        isUnispectMaster() || ('role' in request.auth.token && request.auth.token.role == 'CLIENT_ADMIN')
      );
    }

    function isInspector(targetClientId) {
      return hasClientAccess(targetClientId) && (
        isUnispectMaster() || ('role' in request.auth.token && request.auth.token.role == 'INSPECTOR')
      );
    }

    // Regras de armazenamento de fotos em containers/{containerId}/{photoFile}
    match /containers/{containerId}/{photoFile} {

      // LEITURA:
      // 1. Exige que o arquivo possua metadados claros de cliente proprietário.
      //    Arquivos com propriedade ambígua ou ausente (ex: arquivos legados não anotados)
      //    têm leitura DIRETA bloqueada para evitar vazamento cross-tenant, preservando o arquivo no bucket.
      // 2. Valida vínculo do usuário com o clientId do arquivo.
      // 3. Se for EXPORTER, restringe estritamente às fotos vinculadas ao seu exporterId.
      allow read: if isAuthenticated() && isNotRevoked() &&
                  resource.metadata != null &&
                  ('clientId' in resource.metadata) &&
                  hasClientAccess(resource.metadata.clientId) && (
                    !('role' in request.auth.token && request.auth.token.role == 'EXPORTER') ||
                    ('exporterId' in resource.metadata && 'exporterId' in request.auth.token && resource.metadata.exporterId == request.auth.token.exporterId)
                  );

      // CRIAÇÃO E ATUALIZAÇÃO (SOBRESCRITA):
      // 1. Exige metadado customizado declarando o clientId proprietário no payload.
      // 2. Usuário deve ser Inspetor, Admin ou Master com autorização expressa para aquele clientId.
      // 3. Usuários sem papel reconhecido (ou papéis não operacionais) têm gravação rejeitada.
      // 4. Se for sobrescrita (update), impede transferir a propriedade para outro cliente.
      // 5. Validação rigorosa de payload (<= 45KB e formato image/jpeg).
      allow create: if isAuthenticated() && isNotRevoked() &&
                    request.resource.metadata != null &&
                    ('clientId' in request.resource.metadata) &&
                    (isInspector(request.resource.metadata.clientId) || isClientAdmin(request.resource.metadata.clientId)) &&
                    request.resource.size <= 45 * 1024 &&
                    request.resource.contentType.matches('image/jpeg');

      allow update: if isAuthenticated() && isNotRevoked() &&
                    resource.metadata != null &&
                    ('clientId' in resource.metadata) &&
                    request.resource.metadata != null &&
                    ('clientId' in request.resource.metadata) &&
                    request.resource.metadata.clientId == resource.metadata.clientId &&
                    (isInspector(resource.metadata.clientId) || isClientAdmin(resource.metadata.clientId)) &&
                    request.resource.size <= 45 * 1024 &&
                    request.resource.contentType.matches('image/jpeg');

      // EXCLUSÃO:
      // 1. Exige que o arquivo possua cliente identificado.
      // 2. Exclusão estritamente restrita a Administrador do CLIENTE PROPRIETÁRIO (ou Master).
      // 3. Inspetores, exportadores ou admins de outros clientes são bloqueados.
      allow delete: if isAuthenticated() && isNotRevoked() &&
                    resource.metadata != null &&
                    ('clientId' in resource.metadata) &&
                    isClientAdmin(resource.metadata.clientId);
    }

    // Bloqueio padrão para qualquer caminho fora de containers/
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

