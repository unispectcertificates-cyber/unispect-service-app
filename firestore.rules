rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funções auxiliares de autenticação e validação
    function isAuthenticated() {
      return request.auth != null;
    }

    // Coleções existentes do UNISPECT
    match /usuarios/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /locais/{localId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /exportadores/{exporterId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /inspectors/{inspectorId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /bookings/{bookingId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    match /bookingImports/{importId} {
      allow read, write: if isAuthenticated();
    }

    match /bookingNumberKeys/{key} {
      allow read, write: if isAuthenticated();
    }

    match /bookingCounters/{counter} {
      allow read, write: if isAuthenticated();
    }

    match /containerPhotos/{photoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // ─────────────────────────────────────────────────────────────
    // NOVAS COLEÇÕES DO MODO CAMPO (Sem Booking)
    // ─────────────────────────────────────────────────────────────

    // Cadastro único pendente de container conferido no campo
    match /fieldContainers/{normalizedNumber} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Histórico e idempotência de envio das operações de campo
    match /fieldOperations/{operationId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Histórico de exclusões e tombstones anti-ressurreição
    match /fieldContainerDeletions/{deletionId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ─────────────────────────────────────────────────────────────
    // MÓDULO: INVENTÁRIO DO PÁTIO
    // ─────────────────────────────────────────────────────────────

    function isAdmin() {
      return isAuthenticated() && (request.auth.token.role == 'ADM' || request.auth.token.admin == true);
    }

    // Passagens de containers pelo pátio
    match /yardPassages/{passageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      // Atualização comum permitida a inspetores; transição para saída ('exited') exclusiva de ADM
      allow update: if isAuthenticated() && (
        request.resource.data.status != 'exited' ||
        resource.data.status == 'exited' ||
        isAdmin()
      );
      allow delete: if false; // Preserva histórico imutável
    }

    // Locks atômicos para unicidade de passagem ativa por pátio/container
    match /yardActiveLocks/{lockKey} {
      allow read, write: if isAuthenticated();
    }

    // Conferências diárias de pátio
    match /yardAudits/{auditId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if false; // Preserva auditorias
    }
  }
}
