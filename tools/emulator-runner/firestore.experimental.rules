rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isNotRevoked() {
      return !exists(/databases/$(database)/documents/userSecurityMetadata/$(request.auth.uid)) ||
        request.auth.token.auth_time > get(/databases/$(database)/documents/userSecurityMetadata/$(request.auth.uid)).data.revokedAt;
    }

    function isUnispectMaster() {
      return isAuthenticated() && isNotRevoked() &&
        ('isUnispectMaster' in request.auth.token && request.auth.token.isUnispectMaster == true);
    }

    function hasClientAccess(targetClientId) {
      return isAuthenticated() && isNotRevoked() && (
        isUnispectMaster() ||
        (targetClientId != null && 'authorizedClients' in request.auth.token && targetClientId in request.auth.token.authorizedClients)
      );
    }

    function isClientAdmin(targetClientId) {
      return hasClientAccess(targetClientId) && (
        isUnispectMaster() || ('role' in request.auth.token && request.auth.token.role == 'CLIENT_ADMIN')
      );
    }

    function isInspector(targetClientId) {
      return hasClientAccess(targetClientId) && (
        isUnispectMaster() || ('role' in request.auth.token && request.auth.token.role == 'INSPECTOR')
      );
    }

    function isInspectorOperationalUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'inspectorNotes', 'surveyDate', 'seals', 'containers', 'updatedAt', 'lastInspectionAt'].toSet());
    }

    // Metadados de revogação de segurança do usuário
    match /userSecurityMetadata/{userId} {
      allow read: if isAuthenticated();
      allow write: if isUnispectMaster();
    }

    // Regras multi-cliente para /bookings
    match /bookings/{bookingId} {
      // 1. LEITURA: Respeita isolamento de cliente e restrição de exportador
      allow read: if (
        isUnispectMaster() ||
        ('clientId' in resource.data && hasClientAccess(resource.data.clientId))
      ) && (
        !('role' in request.auth.token && request.auth.token.role == 'EXPORTER') ||
        ('exporterId' in resource.data && 'exporterId' in request.auth.token && resource.data.exporterId == request.auth.token.exporterId)
      );

      // 2. CRIAÇÃO: Bloqueia usuários sem papel reconhecido e exportadores (apenas Admin do Cliente ou Master)
      allow create: if hasClientAccess(request.resource.data.clientId) &&
        isClientAdmin(request.resource.data.clientId);

      // 3. ATUALIZAÇÃO:
      // - Bloqueia alteração indevida de clientId para todos
      // - Limita o inspetor estritamente aos campos operacionais (bloqueia alteração de exporterId, certificateNumber, etc.)
      // - Bloqueia usuários sem papel reconhecido e exportadores
      allow update: if hasClientAccess(resource.data.clientId) &&
        request.resource.data.clientId == resource.data.clientId && (
          isClientAdmin(resource.data.clientId) ||
          (isInspector(resource.data.clientId) && isInspectorOperationalUpdate())
        );

      // 4. EXCLUSÃO: Restrita estritamente a administradores do cliente ou Master
      allow delete: if isClientAdmin(resource.data.clientId);
    }

    // Regras para metadados de fotos /containerPhotos/{photoId}
    match /containerPhotos/{photoId} {
      // LEITURA: Exportador lê apenas fotos de suas próprias cargas
      allow read: if hasClientAccess(resource.data.clientId) && (
        !('role' in request.auth.token && request.auth.token.role == 'EXPORTER') ||
        ('exporterId' in resource.data && 'exporterId' in request.auth.token && resource.data.exporterId == request.auth.token.exporterId)
      );

      // CRIAÇÃO: Exige papel operacional reconhecido (Inspetor ou Admin do Cliente)
      allow create: if hasClientAccess(request.resource.data.clientId) &&
        (isClientAdmin(request.resource.data.clientId) || isInspector(request.resource.data.clientId));

      // ATUALIZAÇÃO:
      // Protege os vínculos fundamentais (clientId, exporterId, containerId, storagePath).
      // Alteração legítima de vínculos exige procedimento autorizado de Master Unispect.
      allow update: if isUnispectMaster() || (
        (isClientAdmin(resource.data.clientId) || isInspector(resource.data.clientId)) &&
        request.resource.data.clientId == resource.data.clientId &&
        request.resource.data.storagePath == resource.data.storagePath &&
        request.resource.data.containerId == resource.data.containerId &&
        (!('exporterId' in resource.data) || request.resource.data.exporterId == resource.data.exporterId)
      );

      // EXCLUSÃO: Restrita ao Administrador do Cliente proprietário ou Master
      allow delete: if isClientAdmin(resource.data.clientId);
    }

    // Regras para /yardPassages (Histórico de Pátio)
    match /yardPassages/{passageId} {
      allow read: if (!('role' in request.auth.token && request.auth.token.role == 'EXPORTER')) && hasClientAccess(resource.data.clientId);
      
      // CRIAÇÃO: Bloqueia usuários sem papel reconhecido e exportadores
      allow create: if (isClientAdmin(request.resource.data.clientId) || isInspector(request.resource.data.clientId));
      
      // ATUALIZAÇÃO: Bloqueia exportadores e usuários sem papel; restringe baixa definitiva ('exited') a Admins
      allow update: if (isClientAdmin(resource.data.clientId) || isInspector(resource.data.clientId)) &&
        request.resource.data.clientId == resource.data.clientId && (
          request.resource.data.status != 'exited' ||
          isClientAdmin(resource.data.clientId)
        );
      
      // EXCLUSÃO: Imutabilidade estrita
      allow delete: if false;
    }

    // Coleções de apoio operacional: locais, exportadores, inspectores
    match /locais/{localId} {
      allow read: if isAuthenticated() && isNotRevoked();
      allow write: if isUnispectMaster() || (isClientAdmin(request.resource.data.clientId));
    }

    match /exportadores/{exporterId} {
      allow read: if isAuthenticated() && isNotRevoked();
      allow write: if isUnispectMaster() || (isClientAdmin(request.resource.data.clientId));
    }

    match /inspectors/{inspectorId} {
      allow read: if isAuthenticated() && isNotRevoked();
      allow write: if isUnispectMaster() || (isClientAdmin(request.resource.data.clientId));
    }

    match /reports/{reportId} {
      allow read: if isAuthenticated() && isNotRevoked() && (
        !('clientId' in resource.data) || hasClientAccess(resource.data.clientId)
      );
      allow write: if isAuthenticated() && isNotRevoked() && (
        isUnispectMaster() || isClientAdmin(request.resource.data.clientId) || isInspector(request.resource.data.clientId)
      );
    }

    match /fieldContainers/{fcId} {
      allow read: if isAuthenticated() && isNotRevoked() && (
        !('clientId' in resource.data) || hasClientAccess(resource.data.clientId)
      );
      allow write: if isAuthenticated() && isNotRevoked() && (
        isUnispectMaster() || isClientAdmin(request.resource.data.clientId) || isInspector(request.resource.data.clientId)
      );
    }
  }
}
